# ===================================================================
#  Imago — production configuration
#  Copy to .env on the server and fill in the values:  cp .env.example .env
#  Never commit .env (it is in .gitignore).
# ===================================================================

# --- Web ---------------------------------------------------------------
# Port published on the host (the app listens on 8080 inside the container).
IMAGO_PORT=8080
# Session cookies are marked Secure (HTTPS only). Set to false only for plain-HTTP testing.
COOKIE_SECURE=true
# Hours of inactivity before users must sign in again.
SESSION_HOURS=12

# --- Database (PostgreSQL container) -----------------------------------
POSTGRES_DB=imago
POSTGRES_USER=imago
# Long random value, e.g. output of: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- First administrator -----------------------------------------------
# Used only on the very first start, when the database has no users.
# Minimum 12 characters. You can remove ADMIN_PASSWORD after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Administrateur

# --- Microsoft Entra ID app registration ---------------------------------
# One app registration (client credentials) is used for Business Central and Outlook.
#   Business Central: API permission "Dynamics 365 Business Central > API.ReadWrite.All" (application),
#                     then register the app in BC ("Microsoft Entra Applications") with permission sets.
#   Outlook mailbox:  Microsoft Graph "Mail.Read" (application), or "Mail.ReadWrite" if GRAPH_MARK_READ=true.
#                     Restrict it to the invoice mailbox with an Exchange application access policy.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Business Central --------------------------------------------------
# Environment name as shown in the BC admin center (e.g. Production, Sandbox).
BC_ENVIRONMENT=Sandbox
# Company id (GUID). Use "Test connection" in Administration > System to list your companies and ids.
BC_COMPANY_ID=
# draft = create the purchase invoice in BC for review; post = create and post it.
BC_POST_MODE=draft
# Currency of your BC company (BC leaves the currency empty on local-currency documents).
BC_LOCAL_CURRENCY=CAD

# --- Invoice mailbox (Microsoft Graph) -----------------------------------
GRAPH_MAILBOX=
GRAPH_FOLDER=inbox
GRAPH_MARK_READ=false
# How far back the first sync looks (days).
GRAPH_LOOKBACK_DAYS=30
# Automatic sync every N minutes (0 = only when someone clicks "Sync").
GRAPH_SYNC_MINUTES=10

# --- Gestion O365 (Microsoft 365 tenants) --------------------------------
# A MULTI-TENANT app registration ("Accounts in any organizational directory"), with:
#   Microsoft Graph (application): User.ReadWrite.All, Organization.Read.All, Directory.Read.All
#   Office 365 Exchange Online (application): Exchange.ManageAsApp
#   Redirect URI (Web): https://<your Imago address>/o365
# In EACH managed tenant:
#   1. Add the tenant in Imago, click "Admin consent" and approve as a Global Administrator.
#   2. In Entra ID > Roles, assign the app's enterprise application the "Exchange Administrator"
#      role (contacts and distribution groups) and the "User Administrator" role (password resets).
# Leave empty to reuse MS_CLIENT_ID / MS_CLIENT_SECRET.
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# --- Automatic PDF reading (AI) ------------------------------------------
# Leave everything empty to disable: invoices are then entered by hand from the PDF.
# AI_PROVIDER = anthropic | gemini. If empty, whichever key below is set is used (Anthropic first).
AI_PROVIDER=
# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Google Gemini (free tier available at https://aistudio.google.com/apikey).
# Free-tier content may be used by Google to improve its products: use test data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
