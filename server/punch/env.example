# Copy to .env.punch at the root of the project (never committed), then restart `npm run pointage`.
# Gmail account that sends the punch card e-mails (later the pubco.ca Google Workspace account).
# PUNCH_SMTP_PASSWORD is a Google "app password" (16 letters), not the normal password:
# Google account → Security → 2-Step Verification → App passwords.
PUNCH_SMTP_USER=
PUNCH_SMTP_PASSWORD=
PUNCH_FROM_NAME=Pubco – Pointage
# Optional: address put in the e-mail links (default: https://<this computer's network address>:8443)
# PUNCH_PUBLIC_URL=
# PUNCH_PORT=8443
